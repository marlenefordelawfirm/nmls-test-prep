// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String
  role              Role      @default(STUDENT)
  state             String?
  subscriptionTier  Tier      @default(FREE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  testAttempts              TestAttempt[]
  userContentAreaProgress   UserContentAreaProgress[]
  userSubTopicPerformance   UserSubTopicPerformance[]
  studyAids                 StudyAid[]
  questionsSeen             QuestionSeen[]
  agentConversations        AgentConversation[]
  userFlashcards            UserFlashcard[]
  settings                  UserSettings?
  achievements              UserAchievement[]
}

model UserSettings {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification Preferences
  emailNotifications    Boolean   @default(true)
  studyReminders        Boolean   @default(true)
  achievementAlerts     Boolean   @default(true)
  weeklyProgress        Boolean   @default(false)

  // Study Preferences
  questionsPerTest      Int       @default(20)
  enableTimeLimit       Boolean   @default(false)
  timeLimitMinutes      Int       @default(30)
  showExplanations      Boolean   @default(true)

  // Appearance Preferences
  theme                 String    @default("system")
  fontSize              String    @default("medium")
  reduceMotion          Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

enum Role {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum Tier {
  FREE
  MONTHLY
  ANNUAL
}

// ============================================================================
// CONTENT STRUCTURE
// ============================================================================

model ContentArea {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String    @db.Text
  percentageOfExam Float
  sortOrder       Int
  createdAt       DateTime  @default(now())

  subTopics       SubTopic[]
  questions       Question[]
  userProgress    UserContentAreaProgress[]
  testAttempts    TestAttempt[]
}

model SubTopic {
  id                String      @id @default(cuid())
  contentAreaId     String
  contentArea       ContentArea @relation(fields: [contentAreaId], references: [id])
  name              String
  description       String      @db.Text
  keywords          String[]
  learningResources Json?
  createdAt         DateTime    @default(now())

  questions         Question[]
  userPerformance   UserSubTopicPerformance[]
  studyAids         StudyAid[]
  userFlashcards    UserFlashcard[]
}

// ============================================================================
// QUESTIONS
// ============================================================================

model Question {
  id                String        @id @default(cuid())
  contentAreaId     String
  contentArea       ContentArea   @relation(fields: [contentAreaId], references: [id])
  subTopicId        String
  subTopic          SubTopic      @relation(fields: [subTopicId], references: [id])

  questionText      String        @db.Text
  optionA           String
  optionB           String
  optionC           String
  optionD           String
  correctAnswer     String
  explanation       String        @db.Text

  difficulty        Difficulty
  bloomsLevel       BloomsLevel
  difficultyWeight  Float         @default(1.0)

  usesThreshold     Boolean       @default(false)
  thresholdRefs     String[]
  isExperimental    Boolean       @default(false)

  createdBy         CreatedBy
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  answers           Answer[]
  questionsSeen     QuestionSeen[]

  @@index([contentAreaId, subTopicId])
  @@index([difficulty])
  @@index([approvalStatus])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomsLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
}

enum CreatedBy {
  ADMIN
  AI
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// TEST ATTEMPTS & ANSWERS
// ============================================================================

model TestAttempt {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])

  type              TestType
  contentAreaId     String?
  contentArea       ContentArea?  @relation(fields: [contentAreaId], references: [id])

  startTime         DateTime      @default(now())
  endTime           DateTime?

  totalQuestions    Int
  scoredQuestions   Int
  correctAnswers    Int
  rawScore          Float
  loftAdjustedScore Float?

  status            TestStatus    @default(IN_PROGRESS)
  createdAt         DateTime      @default(now())

  answers           Answer[]

  @@index([userId, type])
  @@index([status])
}

model Answer {
  id              String        @id @default(cuid())
  testAttemptId   String
  testAttempt     TestAttempt   @relation(fields: [testAttemptId], references: [id])
  questionId      String
  question        Question      @relation(fields: [questionId], references: [id])

  selectedAnswer  String
  isCorrect       Boolean
  timeSpent       Int
  wasRepeat       Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([testAttemptId])
  @@index([questionId])
}

enum TestType {
  SECTION_PRACTICE
  CUSTOM_PRACTICE
  FULL_EXAM
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ============================================================================
// PERFORMANCE TRACKING
// ============================================================================

model UserSubTopicPerformance {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  subTopicId        String
  subTopic          SubTopic    @relation(fields: [subTopicId], references: [id])

  totalAttempts     Int         @default(0)
  correctAnswers    Int         @default(0)
  incorrectAnswers  Int         @default(0)
  masteryScore      Float       @default(0)

  avgTimeSpent      Float?
  lastAttemptDate   DateTime?

  difficultyBreakdown Json?
  bloomsBreakdown     Json?

  trend             Trend       @default(PLATEAUED)
  nextReviewDate    DateTime?

  updatedAt         DateTime    @updatedAt

  @@unique([userId, subTopicId])
  @@index([userId, masteryScore])
}

model UserContentAreaProgress {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  contentAreaId   String
  contentArea     ContentArea   @relation(fields: [contentAreaId], references: [id])

  masteryScore    Float         @default(0)
  status          ProgressStatus @default(NOT_STARTED)
  totalAttempts   Int           @default(0)
  bestScore       Float?
  lastAttemptDate DateTime?

  weakSubTopics   String[]
  strongSubTopics String[]

  updatedAt       DateTime      @updatedAt

  @@unique([userId, contentAreaId])
  @@index([userId, status])
}

enum Trend {
  IMPROVING
  DECLINING
  PLATEAUED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_REVIEW
  MASTERED
}

// ============================================================================
// STUDY AIDS
// ============================================================================

model StudyAid {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  subTopicId      String
  subTopic        SubTopic  @relation(fields: [subTopicId], references: [id])

  content         String    @db.Text
  generatedAt     DateTime  @default(now())
  wasHelpful      Boolean?

  @@index([userId, subTopicId])
}

// ============================================================================
// SPACED REPETITION
// ============================================================================

model QuestionSeen {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  questionId            String
  question              Question  @relation(fields: [questionId], references: [id])

  timesSeen             Int       @default(0)
  lastSeenDate          DateTime?
  timesCorrect          Int       @default(0)
  timesIncorrect        Int       @default(0)
  nextEligibleDate      DateTime?

  updatedAt             DateTime  @updatedAt

  @@unique([userId, questionId])
  @@index([userId, nextEligibleDate])
}

// ============================================================================
// FINANCIAL THRESHOLDS
// ============================================================================

model FinancialThreshold {
  id              String    @id @default(cuid())
  key             String    @unique
  value           Float
  year            Int
  source          String
  lastUpdated     DateTime  @default(now())
  isActive        Boolean   @default(true)

  @@index([year, isActive])
}

// ============================================================================
// AI AGENT CHAT
// ============================================================================

model AgentConversation {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])

  title       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages    AgentMessage[]

  @@index([userId, updatedAt])
}

model AgentMessage {
  id              String              @id @default(cuid())
  conversationId  String
  conversation    AgentConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role            MessageRole
  content         String              @db.Text
  toolCalls       Json?
  toolResults     Json?

  createdAt       DateTime            @default(now())

  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ============================================================================
// FLASHCARDS
// ============================================================================

model UserFlashcard {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  subTopicId      String
  subTopic        SubTopic    @relation(fields: [subTopicId], references: [id])

  front           String      @db.Text
  back            String      @db.Text

  nextReviewDate  DateTime
  timesReviewed   Int         @default(0)

  createdAt       DateTime    @default(now())

  @@index([userId, nextReviewDate])
}

// ============================================================================
// ACHIEVEMENTS
// ============================================================================

model Achievement {
  id              String              @id @default(cuid())
  key             String              @unique // e.g., "first_test", "perfect_score"
  title           String
  description     String              @db.Text
  category        AchievementCategory
  targetValue     Int                 // e.g., 1 for "complete 1 test", 100 for "100% score"
  icon            String?             // Icon name or emoji
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())

  userAchievements UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  progress        Int         @default(0)
  isCompleted     Boolean     @default(false)
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId, isCompleted])
}

enum AchievementCategory {
  TESTS
  SCORES
  STREAK
  STUDY_TIME
  MASTERY
}
